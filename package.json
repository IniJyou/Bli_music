{
  "name": "bli-music",
  "version": "0.1.0",
  "private": true,
  "description": "Windows music player with anonymous Bilibili search and audio queues",
  "type": "module",
  "main": "out/main/index.js",
  "license": "UNLICENSED",
  "engines": { "node": ">=24.16.0 <25" },
  "scripts": {
    "dev": "node scripts/run.mjs dev",
    "build": "node scripts/run.mjs build",
    "start": "node scripts/run.mjs start",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.ts",
    "smoke:p0": "node scripts/run.mjs smoke",
    "smoke:p1": "node scripts/run.mjs smoke",
    "start:software": "node scripts/run.mjs start-software"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.0.4",
    "electron": "45.1.0",
    "electron-vite": "5.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  }
}
