{
  "appId": "com.inijyou.blimusic",
  "productName": "Bli Music",
  "directories": {
    "output": "release",
    "buildResources": "resources"
  },
  "files": [
    "out/main/index.js",
    "out/preload/index.cjs",
    "out/renderer/**",
    "resources/coffee.ico",
    "THIRD_PARTY_NOTICES.txt",
    "LICENSE",
    "package.json",
    "!node_modules/**"
  ],
  "asar": true,
  "electronDist": "node_modules/electron/dist",
  "electronVersion": "45.1.0",
  "electronLanguages": ["en-US", "zh-CN", "zh-TW"],
  "npmRebuild": false,
  "forceCodeSigning": false,
  "win": {
    "target": [{ "target": "nsis", "arch": ["x64"] }],
    "icon": "resources/coffee.ico",
    "executableName": "BliMusic"
  },
  "nsis": {
    "include": "resources/installer.nsh",
    "oneClick": false,
    "perMachine": false,
    "allowElevation": false,
    "allowToChangeInstallationDirectory": true,
    "runAfterFinish": false,
    "deleteAppDataOnUninstall": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "differentialPackage": false,
    "installerLanguages": ["zh_CN", "zh_TW", "en_US"],
    "artifactName": "Bli-Music-${version}-win-x64-setup.${ext}"
  },
  "publish": null
}
